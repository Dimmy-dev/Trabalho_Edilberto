{
  "openapi": "3.1.0",
  "info": {
    "title": "Grand Plaza Hotel Management API",
    "description": "API REST Segura para Gerenciamento de Hóspedes, Reservas e Pagamentos Pix — Laboratório de Inovação III",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Monitoramento"
        ],
        "summary": "Health Check",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/hospedes": {
      "post": {
        "tags": [
          "Hóspedes"
        ],
        "summary": "Cadastrar Novo Hóspede (RF-001)",
        "description": "Cadastra um novo hóspede aplicando validação estrita (Módulo 11 para CPF, RFC 5322 para e-mail)\ne proteção contra SQL Injection através de Prepared Statements (SQLAlchemy).",
        "operationId": "criar_hospede_api_v1_hospedes_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HospedeCreateSchema"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_HospedeResponseSchema_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Hóspedes"
        ],
        "summary": "Listar Hóspedes Cadastrados",
        "description": "Retorna a listagem paginada de hóspedes ordenada pelos registros mais recentes.",
        "operationId": "listar_hospedes_api_v1_hospedes_get",
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_List_HospedeResponseSchema__"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
