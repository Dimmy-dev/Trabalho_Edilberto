          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "success"
        ],
        "title": "ApiResponse[HospedeResponseSchema]"
      },
      "ApiResponse_List_HospedeResponseSchema__": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "data": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/HospedeResponseSchema"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "success"
        ],
        "title": "ApiResponse[List[HospedeResponseSchema]]"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HospedeCreateSchema": {
        "properties": {
          "nome": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3,
            "title": "Nome",
            "description": "Nome completo do hóspede",
            "example": "João da Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "E-mail válido",
            "example": "joao.silva@email.com"
          },
          "cpf": {
            "type": "string",
            "title": "Cpf",
            "description": "CPF válido de 11 dígitos",
            "example": "12345678901"
          },
          "telefone": {
            "type": "string",
            "maxLength": 20,
            "minLength": 10,
            "title": "Telefone",
            "description": "Telefone com DDD",
            "example": "11999998888"
          },
          "data_nascimento": {
            "type": "string",
            "format": "date",
            "title": "Data Nascimento",
            "description": "Data de nascimento (AAAA-MM-DD)",
            "example": "1990-03-15"
          },
          "observacoes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Observacoes",
            "description": "Preferências ou notas VIP"
          }
        },
        "type": "object",
        "required": [
          "nome",
          "email",
          "cpf",
          "telefone",
          "data_nascimento"
        ],
        "title": "HospedeCreateSchema"
      },
      "HospedeResponseSchema": {
        "properties": {
          "uuid_publico": {
            "type": "string",
            "title": "Uuid Publico"
          },
          "nome": {
            "type": "string",
            "title": "Nome"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "cpf": {
            "type": "string",
            "title": "Cpf"
          },
          "telefone": {
            "type": "string",
            "title": "Telefone"
          },
          "data_nascimento": {
            "type": "string",
            "format": "date",
            "title": "Data Nascimento"
          },
          "observacoes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observacoes"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "uuid_publico",
          "nome",
          "email",
          "cpf",
          "telefone",
          "data_nascimento",
          "created_at"
        ],
        "title": "HospedeResponseSchema"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
